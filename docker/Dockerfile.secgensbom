# syntax=docker/dockerfile:1
FROM python:3.13-slim

ARG VERSION=latest
ARG SYFT_VERSION=v1.45.1

LABEL org.opencontainers.image.title="sbom-pipeline" \
      org.opencontainers.image.description="SBOM Generator & Formatter — CycloneDX 1.5, Syft, Trivy, OWASP Dependency-Check" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/geminishkv/sbom_genform" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.authors="Elijah S Shmakov"

# --- Системные зависимости + Docker CLI ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg git jq \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
    https://download.docker.com/linux/debian \
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list \
 && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli

# --- Trivy ---
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
    | sh -s -- -b /usr/local/bin v0.70.0

# --- Syft ---
RUN curl -sSfL https://get.anchore.io/syft \
    | sh -s -- -b /usr/local/bin "${SYFT_VERSION}" \
 && syft version

# --- clairctl ---
# Kept as a fallback; the primary execution path is `docker exec <clair-container> clairctl`
# which uses the binary already bundled in the Clair image.
RUN ARCH=$(dpkg --print-architecture) \
 && curl -fsSL "https://github.com/quay/clair/releases/download/v4.9.0/clairctl-linux-${ARCH}" \
    -o /usr/local/bin/clairctl \
 && chmod +x /usr/local/bin/clairctl

# --- Node.js LTS + npx (cdxgen для non-Python проектов) ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs

# --- Python-пакет sbom-pipeline ---
WORKDIR /app
COPY pyproject.toml LICENSE.md README.md ./
COPY docs/ ./docs/
COPY src/ ./src/
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir . \
 && chmod +x /usr/local/bin/secsbom /usr/local/bin/secsbom-pipeline

# --- Демо-проект (монтируй свой через -v /path:/app/project_inject) ---
COPY examples/project_inject ./examples/project_inject

# --- Создание непривилегированного пользователя ---
RUN groupadd --gid 1001 sbom \
 && useradd --uid 1001 --gid sbom --create-home --shell /usr/sbin/nologin sbom \
 && chown -R sbom:sbom /app

# --- Переменные по умолчанию ---
ENV PYTHONUNBUFFERED=1 \
    PROJECT_DIR=/app/examples/project_inject \
    OUTPUT_DIR=/app/secgensbom_out \
    REPORTS_DIR=/app/secgensbom_reports \
    SOURCE=local

VOLUME ["/app/project_inject", "/app/secgensbom_out", "/app/secgensbom_reports"]

# --- Healthcheck: CLI и его зависимости отвечают ---
HEALTHCHECK --interval=5m --timeout=10s --start-period=10s --retries=3 \
    CMD secsbom --version >/dev/null 2>&1 || exit 1

# --- Запуск от имени непривилегированного пользователя ---
USER sbom

ENTRYPOINT ["secsbom-pipeline"]
CMD ["run", "-v"]
